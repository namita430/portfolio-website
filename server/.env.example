# =============================================================================
# Backend environment variables.  Copy to `.env` for local development.
# NEVER commit the real `.env`. In production set these in your host's dashboard.
# =============================================================================

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Database (MySQL 8) -------------------------------------------------------
# Local:   mysql://USER:PASSWORD@127.0.0.1:3306/portfolio
# Aiven:   mysql://avnadmin:PASSWORD@HOST:PORT/defaultdb   (see docs/DEPLOYMENT.md for TLS)
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/portfolio"
# Optional: PEM text of the provider's CA certificate (e.g. Aiven's ca.pem). When set,
# scripts/start-prod.cjs writes it to disk and enables verified TLS for Prisma.
DB_CA_CERT=
# NOTE: `prisma migrate dev` (local only) creates a temporary shadow database itself, so the
# local MySQL user needs CREATE/DROP privileges. Production only ever runs `migrate deploy`.

# --- Web / CORS / cookies -----------------------------------------------------
# Comma-separated list of EXACT browser origins allowed to call this API with credentials.
# Add your Netlify URL now and your .com.np domain later, e.g.
#   FRONTEND_ORIGINS=https://your-site.netlify.app,https://yourname.com.np,https://www.yourname.com.np
FRONTEND_ORIGINS=http://localhost:5173
# Number of reverse-proxy hops in front of the API (Render = 1). Needed for correct client IPs.
TRUST_PROXY=0
# lax  -> frontend and API are same-site (custom domain + api. subdomain, or Netlify /api proxy)
# none -> frontend and API on unrelated sites (netlify.app + onrender.com). Requires HTTPS.
COOKIE_SAMESITE=lax

# --- Secrets ------------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-value-at-least-32-chars
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=24

# --- Object storage (S3-compatible: Cloudflare R2, Backblaze B2, MinIO, ...) --------
# local = writes to ./uploads and serves /uploads. DEVELOPMENT ONLY (refused in production).
STORAGE_DRIVER=local
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
UPLOAD_MAX_IMAGE_MB=8
UPLOAD_MAX_DOCUMENT_MB=10

# --- Contact form -------------------------------------------------------------
# Messages are ALWAYS saved to MySQL. Email notification is optional.
# EMAIL_PROVIDER: none | resend | smtp
EMAIL_PROVIDER=none
EMAIL_FROM=
CONTACT_NOTIFY_TO=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional Cloudflare Turnstile (free CAPTCHA). Leave blank to disable.
TURNSTILE_SECRET_KEY=
