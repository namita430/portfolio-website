{
  "name": "portfolio-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express + Prisma + MySQL API for Namita Giri's portfolio",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node scripts/start-prod.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx src/seed/run.ts",
    "seed:demo": "tsx src/seed/demo.ts",
    "seed:demo:clear": "tsx src/seed/demo.ts --clear",
    "admin:create": "tsx scripts/create-admin.ts",
    "admin:reset-password": "tsx scripts/create-admin.ts --reset"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.19.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.1.2",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "prisma": "^6.19.3",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.9.1",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
