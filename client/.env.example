# =============================================================================
# Frontend environment variables (Vite). Copy to `.env.local` for local overrides.
# Only variables starting with VITE_ are exposed to the browser — they are PUBLIC.
# NEVER put passwords, API keys or database URLs in this file.
# In production set these in Netlify -> Site configuration -> Environment variables.
# =============================================================================

# Base URL of the Express API, including /api/v1.
#  - Leave empty in development: the Vite dev server proxies /api to http://localhost:4000.
#  - Production example: https://portfolio-api.onrender.com/api/v1
#    (or https://api.yourname.com.np/api/v1 once your domain is approved)
#  - If you enable the Netlify proxy rule in netlify.toml, use: /api/v1
VITE_API_BASE_URL=

# Public address of this website, no trailing slash. Used at build time for the canonical URL, social-preview
# image and sitemap.xml. If empty, those tags are simply omitted.
# Example: https://your-site.netlify.app  (later: https://yourname.com.np)
VITE_SITE_URL=

# Optional Cloudflare Turnstile SITE key (public). Leave empty to disable the CAPTCHA.
# The matching SECRET key goes on the API server (TURNSTILE_SECRET_KEY), never here.
VITE_TURNSTILE_SITE_KEY=
